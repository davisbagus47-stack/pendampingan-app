# Pendanaan otomatis wallet TPK. Jangan isi private key di file yang di-commit.
TPK_AUTO_FUND_ENABLED=true
TPK_FUNDING_PRIVATE_KEY=
TPK_FUNDING_AMOUNT_ETH=0.1
TPK_FUNDING_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Secret operator untuk menerbitkan kode reset wallet (minimal 32 karakter acak).
# Permintaan penerbitan dilindungi secret ini dan dibatasi kuotanya.
TPK_WALLET_RESET_ADMIN_KEY=
